# Copy to .env.local. On Hostinger these go in the Node app's Environment
# Variables panel. Never commit .env.local.

# WordPress host the server calls for the REST API. Always the subdomain,
# never the proxied root domain. No trailing slash.
WOO_STORE_URL=https://shop.kovacompounds.com

# WooCommerce -> Settings -> Advanced -> REST API (Read permission)
WOO_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOO_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Must match the Cart secret at WooCommerce -> KOVA Bridge exactly.
KOVA_CART_SECRET=change-me-before-launch

# Zapier catch hook for the wholesale form. Server-side only.
KOVA_WHOLESALE_WEBHOOK=https://hooks.zapier.com/hooks/catch/xxxxxxx/xxxxxxx/

# Single-domain mode. Leave unset until a real order completes on the
# plain subdomain handoff.
# WP_ORIGIN=https://shop.kovacompounds.com
# WOO_PUBLIC_URL=https://kovacompounds.com
